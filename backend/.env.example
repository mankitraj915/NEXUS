# PostgreSQL connection (must match docker-compose.yml)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nexus

# Optional: LLM provider for experimental query transformation
# Required only for experimental_multi_query_llm search mode
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Embedding runtime. An index must be queried with the backend that built it.
EMBEDDING_BACKEND=onnx
EMBEDDING_ONNX_VARIANT=fp32
EMBEDDING_MODEL_DIR=models/all-MiniLM-L6-v2-onnx
